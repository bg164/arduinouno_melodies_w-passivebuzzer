const uint16_t SEGMENT_COUNT = sizeof(melody) / sizeof(melody[0]);

void setup() {
  pinMode(BUZZER_PIN, OUTPUT);
  // Fractional-millisecond carry keeps the total timing close to the MIDI.
  unsigned long remainder = 0;
  for (uint16_t i = 0; i < SEGMENT_COUNT; i++) {
    uint16_t frequency = pgm_read_word(&melody[i].frequency);
    uint16_t ticks = pgm_read_word(&melody[i].ticks);
    unsigned long numerator = (unsigned long)ticks * 750UL + remainder;
    unsigned long durationMs = numerator / 384UL;
    remainder = numerator % 384UL;

    if (frequency == 0) {
      noTone(BUZZER_PIN);
      delay(durationMs);
    } else {
      tone(BUZZER_PIN, frequency);
      delay(durationMs);
      noTone(BUZZER_PIN);
    }
  }
  noTone(BUZZER_PIN);
}

void loop() {
  // Plays once after power-up/reset. Press Reset to play it again.
}
